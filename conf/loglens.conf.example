# LogLens 工作区配置示例。
# 拷贝为 conf/loglens.conf 后按需修改；conf/loglens.conf 不被 git 跟踪。
# 优先级：命令行 flag > 本文件 > 环境变量 > 内置默认。
# 参考：https://github.com/sun-crest/loglens 部署一节。

# 允许访问的日志目录（白名单，防路径穿越/软链逃逸）。
# 相对路径以工作区根目录为基准；绝对路径照用。
# 本小节缺失时：工作区模式默认只允许 <root>/logs；经典模式用 LOGLENS_WHITELIST_DIRS。
[dirs]
allow = ["logs", "/var/log"]

# 单次查询资源上限（对应 LOGLENS_MAX_LINES / MAX_BYTES / MAX_FILES / TIMEOUT_MS）。
[limits]
max_lines  = 2000     # 单次查询最多返回行数
max_bytes  = 10485760 # 单次从磁盘读取的最大字节数（10 MiB）
max_files  = 5000     # list_log_files 单次最多返回的文件数
timeout_ms = 15000    # 单次查询超时（毫秒）

# `loglens serve` 的默认值；命令行显式传入 --addr/--token 时覆盖这里。
[serve]
addr  = "127.0.0.1:8787" # 保持回环地址；跨机访问走 SSH 隧道
token = ""               # 留空则不启用鉴权；对外开放端口时必须设置

# LogLens 自身运行日志（脱离 systemd/journald 时用它落盘）。
# file 留空 = 仅 stderr（默认）。
[log]
file        = "logs/loglens.log" # 相对工作区根目录；会自动创建 logs/
max_size_mb = 10                 # 超过该大小按体积轮转，保留 3 份（.1 .2 .3）